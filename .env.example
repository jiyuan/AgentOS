# Copy this file to .env and fill in local values.
# The bootstrap script loads .env automatically and validates required keys.

# Workspace anchor. THE only knob for workspace path resolution. Every
# AgentOS path (agent.toml, traces, sessions, skills, crons, attachments,
# gateway log, PID file) is derived as $AGENTOS_HOME/<subpath>. There are no
# per-path overrides. If unset, the binaries fall back to the parent directory
# of the loaded .env file, or CWD as a last resort.
AGENTOS_HOME=

# LLM provider: builtin.echo, openai, anthropic, deepseek, or ollama.
# AGENTOS_LLM_PROVIDER=openai/anthropic/deepseek

# OpenAI API credentials. Required when AGENTOS_LLM_PROVIDER=openai.
# OPENAI_API_KEY=
# OPENAI_PROJECT_ID=proj_...
# OPENAI_ORG_ID=org_...

# Anthropic API credentials. Required when AGENTOS_LLM_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=

# DeepSeek API credentials. Required when AGENTOS_LLM_PROVIDER=deepseek.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_HOST=https://api.deepseek.com

# LLM model config
# AGENTOS_LLM_MODEL=deepseek-chat
# AGENTOS_LLM_MODEL_HIGH=deepseek-reasoner
# AGENTOS_LLM_MODEL_MEDIUM=deepseek-chat
# AGENTOS_LLM_MODEL_LOW=deepseek-chat
# The tier names above are also what `[compaction].model` in agent.toml picks
# from, so pointing compaction at "low" spends the cheap model on summaries.

# Ollama endpoint. Used when AGENTOS_LLM_PROVIDER=ollama or when provider is inferred from OLLAMA_HOST.
# AGENTOS_LLM_PROVIDER=ollama
# AGENTOS_LLM_MODEL=gemma4:26b
# OLLAMA_HOST=http://127.0.0.1:11434

# Embeddings for the "vector" semantic memory backend
# ([memory].semantic_backend = "vector"). When an API key is set, the vector
# index uses real (paraphrase-capable) embeddings; otherwise it falls back to an
# offline hashing embedder. Works with any OpenAI-compatible /embeddings endpoint
# (OpenAI, or a local server). Falls back to OPENAI_API_KEY if the dedicated key
# is unset.
# AGENTOS_EMBEDDINGS_API_KEY=
# AGENTOS_EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# AGENTOS_EMBEDDINGS_MODEL=text-embedding-3-small

# Channel
# AGENTOS_ENABLED_CHANNELS=telegram,feishu

# Remote channels fail closed: a channel with no allowlist refuses to start
# rather than accepting every sender who can reach it. Set at least one of the
# allowlists below, or opt in to an open channel explicitly with the matching
# ALLOW_ALL. An event the transport could not attribute to a sender is refused
# either way.

# Telegram channel. Required for telegram-once, telegram-cron-smoke, or persistent Telegram gateway usage.
# AGENTOS_TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids this bot answers in.
# AGENTOS_TELEGRAM_CHAT_ID=
# Comma-separated sender ids allowed to talk to it, in any allowed chat.
# AGENTOS_TELEGRAM_SENDER_ID=
# Accept every attributable sender. An open channel, so say it on purpose.
# AGENTOS_TELEGRAM_ALLOW_ALL=0

# Feishu channel. Required for feishu-once, feishu-cron-smoke, or persistent Feishu gateway usage.
# Feishu receive uses the Open Platform long-connection WebSocket mode.
# AGENTOS_FEISHU_APP_ID=
# AGENTOS_FEISHU_APP_SECRET=
# AGENTOS_FEISHU_ALLOWED_ID=
# Comma-separated authorized sender ids (open_id / user_id / union_id).
# AGENTOS_FEISHU_ALLOWED_CHAT_ID=
# Comma-separated chat ids, if you want to bound the conversations too.
# AGENTOS_FEISHU_ALLOW_ALL=0
# AGENTOS_FEISHU_RECEIVE_ID_TYPE=open_id
# Supported values: chat_id, open_id, user_id, union_id
# AGENTOS_FEISHU_API_BASE=https://open.feishu.cn/open-apis

# Diagnostics.
# AGENTOS_CLI_TRACE=0

# Emit per-LLM-call token usage events (provider, model, input/output/total/
# cache_read/cache_write/cache_miss tokens) to the gateway log so the
# audit-skill helper (workspace/skills/audit-skill/scripts/audit_tokens.py)
# can aggregate them. Without this set, the log has zero token lines.
# See crates/agentos-llm/src/providers/mod.rs:138 for the emitter.
# RUST_LOG=agentos_llm::usage=info
